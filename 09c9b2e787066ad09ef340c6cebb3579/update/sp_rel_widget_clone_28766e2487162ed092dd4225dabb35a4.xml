    &lt;/div&gt;
    &lt;div ng-if="data.show_info_widget"&gt;
      &lt;hr&gt;
      &lt;div class="panel-body"&gt;
        &lt;sp-widget widget= "c.data.info_widget" page="{table:data.table, sys_id: data.sys_id}"&gt;&lt;/sp-widget&gt;
